# Which Akku site this app points at. Copy to .env.local and fill in.
#
# Nothing about the POLICY belongs here — purposes, legal bases and expiry windows are all read from
# whatever the console has published for this site key. These values only say WHERE to read it from
# and WHO is asking.
#
# There is deliberately no default for any of the three. A hostname committed here means a fresh
# clone with no environment silently writes consent decisions into somebody's production site.

# Base URL of the Akku API, e.g. https://consent.example.com
VITE_AKKU_API_HOST=

# The site's public site_key. Public by design: it resolves server-side to an org and a site.
VITE_AKKU_SITE_KEY=

# The registered application id (console -> site -> App keys), and the `iss` every Subject Token
# carries. Safe in the browser bundle — it is already inside every token this app holds. Without it
# the authenticated plane cannot be used and the app reports itself unconfigured.
VITE_AKKU_APP_ID=

# Where the BANKING app lives. Four screens link into it, because banking owns the capture of KYC,
# documents and nominees.
#
# This one DOES have a default — banking's own dev port — so two locally-running apps work with no
# environment file. Set it for a deployment. The stakes are different from the values above: the worst
# case here is a link to nothing, not a consent written into the wrong site.
VITE_BANKING_URL=http://localhost:5173
