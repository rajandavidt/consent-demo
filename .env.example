# Copy to apps/banking/.env.local and apps/insurance/.env.local.
#
# The site key is public by design — it resolves server-side to an org and site and is never a
# secret. It is NOT committed with a default, so that a checkout cannot silently point at somebody
# else's site.
#
# The app's origin must be listed in that site's allowed origins, or the browser blocks every read
# with a CORS error and the consent surfaces stay empty. Banking runs on 5173 and insurance on 5300
# for exactly that reason.
VITE_AKKU_API_HOST=https://consentmanagement.akkuiam.com
VITE_AKKU_SITE_KEY=
